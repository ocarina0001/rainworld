    <TerrainDef ParentName="NaturalTerrainBase">
        <defName>OCARINA_OutskirtsPoorSoil</defName>
        <label>sparse soil</label>
        <texturePath>Terrain/Surfaces/OutskirtsPoorSoil</texturePath>
        <pollutedTexturePath>Terrain/Surfaces/OutskirtsPoorSoil</pollutedTexturePath>
        <pollutionOverlayTexturePath>Terrain/Surfaces/RoughStonePollutionOverlay</pollutionOverlayTexturePath>
        <pollutionShaderType MayRequire="Ludeon.RimWorld.Biotech">TerrainFadeRoughLinearAdd</pollutionShaderType>
        <edgeType>FadeRough</edgeType>
        <renderPrecedence>320</renderPrecedence>
        <pathCost>2</pathCost>
        <statBases>
            <Beauty>-4</Beauty>
            <BeautyOutdoors>0</BeautyOutdoors>
            <Cleanliness>-1</Cleanliness>
        </statBases>
        <scatterType>Rocky</scatterType>
        <affordances>
            <li>Light</li>
            <li>Medium</li>
            <li>Heavy</li>
            <li>GrowSoil</li>
            <!-- <li>Diggable</li> -->
        </affordances>
        <generatedFilth>Filth_Dirt</generatedFilth>
        <fertility>0.5</fertility>
        <takeFootprints>True</takeFootprints>
        <tools>
            <li>
                <label>gravel</label>
                <capacities>
                    <li>KickMaterialInEyes</li>
                </capacities>
                <hediff>GravelInEyes</hediff>
                <cooldownTime>1.5</cooldownTime>
            </li>
        </tools>
        <tags>
            <li>Soil</li>
        </tags>
    </TerrainDef>

    <TerrainDef ParentName="WaterShallowBase">
        <defName>OCARINA_OutskirtsWaterShallow</defName>
        <label>shallow water</label>
        <pollutionCloudColor>(80, 87, 85, 0.66)</pollutionCloudColor>
        <texturePath>Terrain/Surfaces/OutskirtsWaterShallowRamp</texturePath>
        <pollutedTexturePath>Terrain/Surfaces/OutskirtsWaterShallowRampPolluted</pollutedTexturePath>
        <waterDepthShader>Map/WaterDepth</waterDepthShader>
        <renderPrecedence>394</renderPrecedence>
        <driesTo>OCARINA_OutskirtsPoorSoil</driesTo>
    </TerrainDef>
